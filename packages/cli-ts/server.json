{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.RudrenduPaul/paceproof",
  "description": "Verifies Ed25519-signed attestation records and builds audit reports via MCP tools.",
  "repository": {
    "url": "https://github.com/RudrenduPaul/PaceProof",
    "source": "github"
  },
  "version": "0.1.1",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "paceproof-cli",
      "version": "0.1.1",
      "runtimeHint": "npx",
      "packageArguments": [
        {
          "type": "positional",
          "valueHint": "subcommand",
          "value": "mcp"
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
